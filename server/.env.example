# Copy values from `supabase start` output. Never commit real secrets.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# Server-side AI secrets (Supabase Edge Function secrets, never shipped in the APK).
OPENROUTER_API_KEY=replace-with-openrouter-key
# Optional: text model used to generate concrete photo tasks.
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.1-8b-instruct:free
# User access token is supplied per request in Postman; do not store a real token here.
